# Single-user passphrase for the app. Change this before deploying anywhere public.
APP_PASSPHRASE=change-me-before-deploying

# Secret used to sign the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=dev-only-secret-change-me

# Production database (Neon or any Postgres). When unset, the app uses an
# embedded PGlite database in ./data/pglite so it runs locally with no server.
# DATABASE_URL=postgres://user:pass@host/db

# Set to 1 to require HTTPS cookies (leave unset for local http).
# SECURE_COOKIES=1
